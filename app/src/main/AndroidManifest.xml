<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.As3">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.As3"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ListViewActivity"
            android:exported="false"
            android:label="ListView 用法"
            android:theme="@style/Theme.As3" />
        <activity
            android:name=".AlertDialogActivity"
            android:exported="false"
            android:label="自定义 AlertDialog"
            android:theme="@style/Theme.As3" />
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:label="XML 定义菜单"
            android:theme="@style/Theme.As3" />
        <activity
            android:name=".ActionModeActivity"
            android:exported="false"
            android:label="ActionMode 上下文菜单"
            android:theme="@style/Theme.As3" />
        <activity
            android:name=".RecyclerViewActivity"
            android:exported="false"
            android:label="RecyclerView 列表"
            android:theme="@style/Theme.As3" />
    </application>

</manifest>